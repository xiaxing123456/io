{
    "extends": "@io-platform/dev-config/tsconfig/tsconfig",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "dist",
        "paths": {
            "@admin-vue/*": ["./src/*"],
            "@locales": ["../../../node_modules/@io-platform/core-locales/src"],
        },
        "types": ["vite/client", "element-plus/global"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
    ],
    "exclude": ["node_modules"]
}

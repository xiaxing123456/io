{
    "extends": "@io-platform/dev-config/tsconfig/tsconfig",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "./src",
        "ignoreDeprecations": "6.0",
        "paths": {
            "@admin-vue/*": ["src/*"],
            "@locales": ["../../../node_modules/@io-platform/core-locales/src"],
        },
        "types": ["vite/client"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
    ],
    "exclude": ["node_modules"]
}

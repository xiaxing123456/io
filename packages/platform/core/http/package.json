{
  "name": "@io-platform/core-http",
  "version": "1.0.0",
  "description": "PIMCenter HTTP 请求模块- 支持多端服用务器请求",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "browser": "dist/cjs/browser/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js",
      "types": "./dist/types/utils/index.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && pnpm type && rollup --config rollup.config.mjs",
    "type": "tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "axios": "0.21.1"
  },
  "devDependencies": {
    "rollup": "4.41.1",
    "rollup-plugin-esbuild": "6.2.1",
    "typescript": "4.9.5"
  },
  "keywords": [],
  "author": "xiaxing",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "files": [
    "src",
    "dist",
    "README.md"
  ]
}

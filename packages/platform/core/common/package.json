{
    "name": "@io-platform/core-common",
    "version": "1.0.0",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "browser": "dist/cjs/browser/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./src/types/*": {
            "import": "./src/types/*",
            "require": "./src/types/*",
            "types": "./src/types/*"
        }
    },
    "scripts": {
        "dev": "rollup --config rollup.config.mjs --watch",
        "build": "rimraf dist && pnpm type && rollup --config rollup.config.mjs",
        "type": "tsc --emitDeclarationOnly",
        "test": "vitest"
    },
    "dependencies": {
        "mathjs": "15.2.0",
        "qs": "6.10.3"
    },
    "devDependencies": {
        "@rollup/plugin-replace": "6.0.2",
        "@types/qs": "^6.9.17",
        "rollup": "4.41.1",
        "rollup-plugin-esbuild": "6.2.1",
        "tslib": "2.8.1"
    },
    "packageManager": "pnpm@10.21.0"
}

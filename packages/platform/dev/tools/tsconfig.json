{
    "compilerOptions": {
        "declaration": true,
        "declarationDir": "dist/types",
        "outDir": "./dist/esm",
        "target": "ESNext",
        "module": "ESNext",
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "tests", "dist"]
}
